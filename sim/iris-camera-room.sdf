<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="kxvo_camera_room">
    <physics name="physics" type="ignored">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional">
      <direction>-0.5 -0.4 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="floor">
        <collision name="plane"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="plane"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></visual>
      </link>
    </model>
    <model name="camera_target">
      <static>true</static>
      <pose>0 3 0.7 0 0 0</pose>
      <link name="target">
        <visual name="board">
          <geometry><box><size>2 0.15 1.4</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.2 0.45 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="kxvo_iris">
      <pose>0 0 0.2 0 0 1.5707963267948966</pose>
      <include>
        <uri>model://iris_with_ardupilot</uri>
        <name>iris</name>
      </include>
      <link name="camera_link">
        <pose relative_to="iris::iris_with_standoffs::base_link">0.08 0 0.05 0 0.261799 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia><ixx>0.0000015</ixx><iyy>0.0000015</iyy><izz>0.0000015</izz></inertia>
        </inertial>
        <sensor name="front_camera" type="camera">
          <topic>/kxvo/front_camera</topic>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.63529009</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>30</far></clip>
          </camera>
        </sensor>
      </link>
      <joint name="camera_mount" type="fixed">
        <parent>iris::iris_with_standoffs::base_link</parent>
        <child>camera_link</child>
      </joint>
    </model>
  </world>
</sdf>
